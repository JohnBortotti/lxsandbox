#!/usr/bin/env bash
# lxsandbox (alias: lxs): a thin CLI over LXD for running coding agents (Claude Code, Codex) in sandboxes.
#
#   env     a named preset: accounts, MCP hook, secrets, default repos, setup script
#   box     an LXD system container cloned from the golden snapshot, with repos in /work
#   session an agent running in tmux inside a box, in bypass mode, as user "agent"
set -euo pipefail

LXSANDBOX_HOME=${LXSANDBOX_HOME:-$HOME/.lxsandbox}
LXSANDBOX_IMAGE=${LXSANDBOX_IMAGE:-images:debian/trixie/cloud}
LXSANDBOX_SSH_KEY=${LXSANDBOX_SSH_KEY:-$HOME/.ssh/id_ed25519}
SRC=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
GOLDEN=lxsandbox-golden
AGENT_SOCK=$LXSANDBOX_HOME/ssh-agent.sock
EGRESS_SOCK=$LXSANDBOX_HOME/egress.sock
mkdir -p "$LXSANDBOX_HOME"/{envs,hooks,egress,accounts/claude,accounts/codex}
chmod 700 "$LXSANDBOX_HOME"

die() { echo "lxs: $*" >&2; exit 1; }
q() { printf '%q' "$1"; }
need_env() { [ -f "$LXSANDBOX_HOME/envs/$1/env.conf" ] || die "no env '$1' (lxs env ls)"; }
is_box() { [ -n "$(lxc config get "$1" user.lxsandbox.env 2>/dev/null)" ]; }

# ---------- output: tables for people, --json for scripts ----------
JSON=0
show() { # show <json array> [empty message] [jq projection of each row for the table]
  if [ "$JSON" = 1 ]; then jq . <<<"$1"; return; fi
  if [ "$(jq length <<<"$1")" = 0 ]; then echo "${2:-(none)}"; return; fi
  jq -r "[.[] | ${3:-.}] | (.[0] | keys_unsorted) as \$k | (\$k | map(ascii_upcase) | @tsv),
    (.[] | [.[\$k[]] | if type == \"array\" then (if length == 0 then \"-\" else join(\", \") end)
      elif . == null or . == \"\" then \"-\" else tostring end] | @tsv)" <<<"$1" | table
}
show_obj() { # show_obj <json object>: one KEY / VALUE row per field
  if [ "$JSON" = 1 ]; then jq . <<<"$1"; return; fi
  show "$(jq -c 'to_entries | map({key, value})' <<<"$1")"
}
table() { # TSV with a header row on stdin -> aligned columns, docker/kubectl style; colors only on a terminal
  local tty=""; [ -t 1 ] && tty=1
  awk -F'\t' -v color="$tty" '
    { for (i = 1; i <= NF; i++) { c[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) }
      if (NF > nf) nf = NF; n = NR }
    function paint(p, v, h) {
      if (!color) return p
      if (h) return "\033[1m" p "\033[0m"
      if (v ~ /^(RUNNING|allowlist|ALLOW|up|ready)$/) return "\033[32m" p "\033[0m"
      if (v ~ /^(open|DENY|down|missing)$/) return "\033[33m" p "\033[0m"
      if (v ~ /^(STOPPED|-)$/) return "\033[2m" p "\033[0m"
      return p }
    END { for (r = 1; r <= n; r++) { s = ""
            for (i = 1; i <= nf; i++) s = s paint(i < nf ? sprintf("%-" w[i] "s", c[r, i]) : c[r, i], c[r, i], r == 1) (i < nf ? "   " : "")
            print s } }'
}
wait_up() { for _ in $(seq 30); do lxc exec "$1" -- true 2>/dev/null && return; sleep 1; done; }
# Run a command in a box as "agent" with a login shell (so ~/.boxenv is loaded).
in_box() { local b=$1; shift
  lxc exec "$b" --user 1000 --group 1000 --cwd /home/agent --env HOME=/home/agent --env USER=agent \
    -- bash -lc "$*" </dev/null; }

usage() { cat <<'U'
lxs status                          overview: golden image, egress proxy, accounts, envs, boxes
                                    (status, ls, ps, env ls|show, egress show|log, account ls take --json)

lxs image build                     create/provision the golden container and snapshot it
lxs image refresh-cli               copy the host's claude + codex binaries into golden

lxs account claude <name>           paste a token, or Enter to run claude setup-token; reused by boxes
lxs account codex <name>            codex login into its own CODEX_HOME, shared by boxes
lxs account ls

lxs env new <env> [--mcp HOOK[:SCOPE]] [--repo R]... [--no-github] [--egress open]
lxs env ls | show <env> | edit <env> [env.conf|secrets.env|setup.sh] | rm <env>

lxs new <box> --env <env> [--repo R]...   R = a local path, ~/workspace/<dir>, owner/name or a git url
lxs ls | shell <box> | snap <box> [name] | stop <box> | start <box>
lxs rm <box> [--force]              refuses if a /work repo has unpushed or uncommitted work
lxs prune [--yes]                   list (or delete) idle boxes with nothing unsaved

lxs egress show <env>               network mode and allowlist (allowlist edits apply to running boxes)
lxs egress allow <env> HOST...      HOST = example.com, *.example.com or host:port
lxs egress remove <env> HOST...
lxs egress mode <env> allowlist|open   for boxes created from now on
lxs egress log [-n N] [--box B]     recent ALLOW/DENY decisions

lxs run <box> claude|codex [--account ACC] [--name S] [--cwd DIR] ["prompt"]
                                    start an agent in tmux session S, logged in as ACC
                                    (ACC may be left out when only one account of that kind exists)
lxs ps <box>                        agent sessions in a box
lxs send <box> <S> "text"           type a message into a session and press Enter
lxs logs <box> <S> [-n N]           last N lines of the session screen (default 60)
lxs attach <box> <S>                attach your terminal to a session
lxs kill <box> <S>
U
}

# ---------- image ----------
image_build() {
  if ! lxc info "$GOLDEN" >/dev/null 2>&1; then
    lxc launch "$LXSANDBOX_IMAGE" "$GOLDEN" -c security.nesting=true \
      -c security.syscalls.intercept.mknod=true -c security.syscalls.intercept.setxattr=true
  fi
  [ "$(lxc list "^$GOLDEN\$" -c s -f csv)" = RUNNING ] || lxc start "$GOLDEN"
  wait_up "$GOLDEN"
  lxc exec "$GOLDEN" -- cloud-init status --wait >/dev/null 2>&1 || true
  lxc file push "$SRC/image/provision.sh" "$GOLDEN/root/provision.sh"
  lxc exec "$GOLDEN" -- bash /root/provision.sh
  image_refresh_cli
  lxc stop "$GOLDEN" --timeout 60 || lxc stop -f "$GOLDEN"
  lxc delete "$GOLDEN/base" 2>/dev/null || true
  lxc snapshot "$GOLDEN" base
  echo "golden ready: $GOLDEN/base"
}
image_refresh_cli() {
  local claude_bin codex_bin
  claude_bin=$(readlink -f "$(command -v claude)") || die "claude not found on host"
  codex_bin=$(readlink -f "$(command -v codex)") || die "codex not found on host"
  [ "$(lxc list "^$GOLDEN\$" -c s -f csv)" = RUNNING ] || { lxc start "$GOLDEN"; wait_up "$GOLDEN"; }
  lxc file push --mode 0755 "$claude_bin" "$GOLDEN/usr/local/bin/claude"
  lxc file push --mode 0755 "$codex_bin" "$GOLDEN/usr/local/bin/codex"
  echo "pushed claude $(claude --version | cut -d' ' -f1), $(codex --version)"
}

# ---------- accounts ----------
account() {
  case "${1:-}" in
    claude)
      local n=${2:?name} f
      f="$LXSANDBOX_HOME/accounts/claude/$n.token"
      read -r -p "Paste a Claude token for '$n', or press Enter to create one with 'claude setup-token': " tok
      if [ -z "$tok" ]; then
        claude setup-token || true
        echo; echo "Copy the sk-ant-... token printed above and paste it here."
        read -r -p "token for $n: " tok
      fi
      tok=${tok//[[:space:]]/}
      [[ $tok == sk-ant-* ]] || die "doesn't look like a Claude token"
      ( umask 077; printf '%s\n' "$tok" > "$f" ); echo "saved $f" ;;
    codex)
      local n=${2:?name} d
      d="$LXSANDBOX_HOME/accounts/codex/$n"
      mkdir -p "$d"; chmod 700 "$d"
      CODEX_HOME=$d codex login --device-auth || CODEX_HOME=$d codex login
      [ -f "$d/auth.json" ] && echo "saved $d/auth.json" ;;
    ls|"") show "$(accounts_json)" "no accounts (lxs account claude|codex <name>)" ;;
    *) die "lxs account claude|codex <name> | ls" ;;
  esac
}

accounts_json() {
  local f k n
  for f in "$LXSANDBOX_HOME"/accounts/claude/*.token "$LXSANDBOX_HOME"/accounts/codex/*/; do
    [ -e "$f" ] || continue; k=$(basename "$(dirname "$f")"); n=$(basename "$f" .token)
    jq -nc --arg k "$k" --arg n "$n" '{agent: $k, account: $n}'
  done | jq -sc .
}

# ---------- envs ----------
env_new() {
  local e=${1:?env name}; shift
  [[ $e =~ ^[a-z0-9-]+$ ]] || die "env names: a-z 0-9 -"
  local d="$LXSANDBOX_HOME/envs/$e"; [ -e "$d" ] && die "env $e exists"
  local mcp="" github=host egress=allowlist repos=()
  while [ $# -gt 0 ]; do case "$1" in
    --mcp) mcp=$2; shift 2;;
    --repo) repos+=("$2"); shift 2;;
    --no-github) github=off; shift;;
    --egress) egress=$2; shift 2;;
    *) die "unknown flag $1";; esac; done
  [ -z "$mcp" ] || [ -x "$LXSANDBOX_HOME/hooks/${mcp%%:*}" ] || die "no MCP hook $LXSANDBOX_HOME/hooks/${mcp%%:*} (see examples/)"
  [[ $egress == allowlist || $egress == open ]] || die "--egress allowlist|open"
  mkdir -p "$d"; chmod 700 "$d"
  cat > "$d/env.conf" <<C
# lxsandbox env: $e
MCP=$mcp               # HOOK[:SCOPE]: hooks/HOOK mints a per-box MCP url + token; empty = none
GITHUB=$github           # host = forward the host's ssh-agent + gh login into boxes; off = none
REPOS="${repos[*]:-}"    # default repos for new boxes
EGRESS=$egress   # allowlist = only hosts in egress.allow (lxs egress ...); open = unrestricted
CPU=4
MEMORY=8GiB
C
  ( umask 077; printf '# KEY=value lines, exported inside the box\n' > "$d/secrets.env" )
  printf '#!/usr/bin/env bash\n# runs as agent inside the box after repos are cloned (cwd /work)\n' > "$d/setup.sh"
  egress_default > "$d/egress.allow"
  echo "env $e created: $d"
}
allow_list() { [ -f "$1" ] && sed -E 's/#.*//; s/^[[:space:]]+//; s/[[:space:]]+$//; /^$/d' "$1" || true; }
envs_json() {
  local d boxes; boxes=$(boxes_json 0)
  for d in "$LXSANDBOX_HOME"/envs/*/; do [ -f "$d/env.conf" ] || continue
    ( . "$d/env.conf"; e=$(basename "$d")
      jq -nc --arg env "$e" --arg mcp "${MCP:-}" \
        --arg github "${GITHUB:-off}" --arg egress "${EGRESS:-open}" --arg repos "${REPOS:-}" \
        --arg cpu "${CPU:-4}" --arg mem "${MEMORY:-8GiB}" --argjson boxes "$boxes" \
        --arg secrets "$(grep -c '^[A-Za-z_]' "$d/secrets.env" 2>/dev/null || true)" \
        --arg allow "$(allow_list "$d/egress.allow")" \
        '{env: $env, mcp: $mcp, github: $github, egress: $egress,
          allow: ($allow | split("\n") | map(select(. != ""))), repos: ($repos | split(" ") | map(select(. != ""))),
          cpu: $cpu, memory: $mem, secrets: ($secrets | tonumber? // 0),
          boxes: [$boxes[] | select(.env == $env) | .box]}' )
  done | jq -sc .
}
env_cmd() {
  local sub=${1:-ls}; shift || true
  case "$sub" in
    new) env_new "$@" ;;
    ls) show "$(envs_json)" "no envs (lxs env new <env>)" \
          '{env, mcp, github, egress, allowed: (.allow | length), repos, boxes: (.boxes | length)}' ;;
    show) need_env "${1:?env}"; show_obj "$(envs_json | jq -c --arg e "$1" '.[] | select(.env == $e)')" ;;
    edit) need_env "$1"; "${EDITOR:-vi}" "$LXSANDBOX_HOME/envs/$1/${2:-env.conf}" ;;
    rm) need_env "$1"; local used
        used=$(lxc list -f csv -c n | while read -r n; do
                 if [ "$(lxc config get "$n" user.lxsandbox.env 2>/dev/null)" = "$1" ]; then echo "$n"; fi; done | paste -sd' ' -)
        [ -z "$used" ] || die "env $1 still used by: $used (lxs rm them first)"
        rm -rf "${LXSANDBOX_HOME:?}/envs/$1"; echo "removed env $1" ;;
    *) die "lxs env new|ls|show|edit|rm" ;;
  esac
}

# ---------- repos ----------
resolve_repo() { # print a local git dir for R; owner/name and git urls are cloned fresh on the host
  local r=$1 t=${CLONE_DIR:-$(mktemp -d)} n
  n=$(basename "${r%.git}")
  if [[ $r =~ ^(ssh|https?|git):// || $r =~ ^[^/:]+@[^/:]+: ]]; then git clone -q "$r" "$t/$n" >&2; echo "$t/$n"
  elif [ -d "$r/.git" ]; then readlink -f "$r"
  elif [ -d "$HOME/workspace/$r/.git" ]; then echo "$HOME/workspace/$r"
  elif [[ $r == */* ]]; then gh repo clone "$r" "$t/$n" -- -q >&2; echo "$t/$n"
  else die "repo not found: $r"; fi
}
push_repo() { # bundle all refs of a host repo, clone it into /work/<name> on a new branch box/<box>
  local b=$1 src=$2 name origin bundle head host ip
  name=$(basename "$src"); origin=$(git -C "$src" remote get-url origin 2>/dev/null || true)
  bundle=$(mktemp --suffix .bundle); git -C "$src" bundle create "$bundle" --all 2>/dev/null
  lxc file push "$bundle" "$b/tmp/$name.bundle"; rm -f "$bundle"
  head=$(git -C "$src" symbolic-ref --short HEAD 2>/dev/null || echo main)
  in_box "$b" "cd /work && git -c init.defaultBranch=main clone -q /tmp/$(q "$name").bundle $(q "$name") && cd $(q "$name") \
    && { git checkout -q $(q "$head") 2>/dev/null || true; } && git checkout -q -b box/$(q "$b") \
    && ${origin:+git remote set-url origin $(q "$origin") &&} rm -f /tmp/$(q "$name").bundle"
  # A dotless origin host only resolves on the host (e.g. tailnet MagicDNS): pin it in the box.
  host=$(sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#[:/].*$##' <<<"$origin")
  [ -n "$host" ] && [ -f "$LXSANDBOX_HOME/egress/$b" ] && echo "$host" >> "$LXSANDBOX_HOME/egress/$b"
  if [ -n "$host" ] && [[ $host != *.* ]]; then
    ip=$(getent hosts "$host" | awk '{print $1; exit}')
    [ -n "$ip" ] && lxc exec "$b" -- sh -c "grep -q ' $host\$' /etc/hosts || echo '$ip $host' >> /etc/hosts"
  fi
  echo "  repo $name ($head → box/$b)"
}

# ---------- github: the host's identity, forwarded in (the private key never enters a box) ----------
ensure_agent() { # a dedicated ssh-agent for boxes, holding the host key
  SSH_AUTH_SOCK=$AGENT_SOCK ssh-add -l >/dev/null 2>&1 && return
  rm -f "$AGENT_SOCK"; ssh-agent -a "$AGENT_SOCK" >/dev/null
  SSH_AUTH_SOCK=$AGENT_SOCK ssh-add -q "$LXSANDBOX_SSH_KEY"
}
github_devices() {
  local b=$1; ensure_agent
  lxc config device add "$b" ssh-agent proxy bind=instance connect="unix:$AGENT_SOCK" \
    listen=unix:/home/agent/.ssh-agent.sock uid=1000 gid=1000 mode=0600 >/dev/null
  [ -d "$HOME/.config/gh" ] && lxc config device add "$b" gh disk source="$HOME/.config/gh" \
    path=/home/agent/.config/gh readonly=true shift=true >/dev/null
  return 0
}
github_config() {
  local b=$1 tmp=$2
  echo "export SSH_AUTH_SOCK=/home/agent/.ssh-agent.sock" >> "$tmp/boxenv"
  [ -f "$HOME/.ssh/known_hosts" ] && lxc file push --uid 1000 --gid 1000 --mode 0600 "$HOME/.ssh/known_hosts" "$b/home/agent/.ssh/known_hosts"
  printf 'Host *\n  StrictHostKeyChecking accept-new\n' >> "$tmp/sshconfig"
  [ -f "$HOME/.ssh/config" ] && cat "$HOME/.ssh/config" >> "$tmp/sshconfig"
  in_box "$b" "git config --global user.name $(q "$(git config --global user.name)") && \
    git config --global user.email $(q "$(git config --global user.email)") && gh auth setup-git >/dev/null 2>&1 || true"
}

# ---------- egress: EGRESS=allowlist boxes have no NIC, only the host proxy (lxsandbox-egress) ----------
egress_default() { cat <<'A'
# Hosts boxes of this env may reach: example.com, *.example.com (subdomains), host:port.
# Edit with lxs egress allow|remove; changes apply to running boxes at once. Repo origins are added per box.
api.anthropic.com
api.openai.com
auth.openai.com
chatgpt.com
github.com
*.github.com
*.githubusercontent.com
registry.npmjs.org
pypi.org
files.pythonhosted.org
deb.debian.org
A
}
ensure_egress() { # start the proxy unless it's already running (a systemd unit may run it too)
  [ -S "$EGRESS_SOCK" ] && kill -0 "$(cat "$LXSANDBOX_HOME/egress.pid" 2>/dev/null)" 2>/dev/null && return
  command -v python3 >/dev/null || die "the egress proxy needs python3 on the host"
  LXSANDBOX_HOME=$LXSANDBOX_HOME setsid nohup python3 "$SRC/lxsandbox-egress" >>"$LXSANDBOX_HOME/egress.err" 2>&1 </dev/null &
  for _ in $(seq 30); do [ -S "$EGRESS_SOCK" ] && return; sleep 0.1; done
  die "egress proxy didn't start, see $LXSANDBOX_HOME/egress.err"
}
egress_devices() { # before first start: drop the NIC, forward the proxy in, register the box's token
  local b=$1 e=$2 tok; ensure_egress
  tok=$(head -c 32 /dev/urandom | base64 | tr -dc A-Za-z0-9 | head -c 32)
  ( umask 077; printf '%s\n%s\n' "$tok" "$e" > "$LXSANDBOX_HOME/egress/$b" )
  lxc config device add "$b" eth0 none >/dev/null
  lxc config device add "$b" egress proxy bind=instance listen=tcp:127.0.0.1:3128 connect="unix:$EGRESS_SOCK" >/dev/null
  EGRESS_AUTH="$b:$tok"
}
egress_config() { # inside the box: proxy env for shells, sudo, apt, docker and ssh
  local b=$1 tmp=$2 url="http://$EGRESS_AUTH@127.0.0.1:3128"
  local np="localhost,127.0.0.1,::1"
  printf 'export HTTP_PROXY=%s HTTPS_PROXY=%s http_proxy=%s https_proxy=%s NO_PROXY=%s no_proxy=%s\n' \
    "$url" "$url" "$url" "$url" "$np" "$np" >> "$tmp/boxenv"
  echo "export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1" >> "$tmp/boxenv"
  printf 'Acquire::http::Proxy "%s";\nAcquire::https::Proxy "%s";\n' "$url" "$url" > "$tmp/apt"
  printf '[Service]\nEnvironment="HTTP_PROXY=%s" "HTTPS_PROXY=%s" "NO_PROXY=%s"\n' "$url" "$url" "$np" > "$tmp/docker"
  cat > "$tmp/connect" <<'S'
#!/usr/bin/env bash
# ssh ProxyCommand: tunnel to $1:$2 through the lxsandbox egress proxy (HTTP CONNECT)
exec 3<>/dev/tcp/127.0.0.1/3128 || exit 1
printf 'CONNECT %s:%s HTTP/1.1\r\nHost: %s:%s\r\nProxy-Authorization: Basic %s\r\n\r\n' \
  "$1" "$2" "$1" "$2" "$(printf %s "$(cat /etc/lxsandbox/proxy-auth)" | base64 -w0)" >&3
IFS= read -r status <&3
case "$status" in *" 200 "*) ;; *) echo "lxsandbox egress: $1:$2 refused: ${status%$'\r'}" >&2; exit 1 ;; esac
while IFS= read -r line <&3 && [ -n "${line%$'\r'}" ]; do :; done
cat <&3 & cat >&3; kill $! 2>/dev/null
S
  printf 'ProxyCommand /usr/local/bin/lxs-connect %%h %%p\n' >> "$tmp/sshconfig"
  lxc exec "$b" -- mkdir -p /etc/lxsandbox /etc/systemd/system/docker.service.d
  printf '%s' "$EGRESS_AUTH" | lxc file push --mode 0644 - "$b/etc/lxsandbox/proxy-auth"
  lxc file push --mode 0755 "$tmp/connect" "$b/usr/local/bin/lxs-connect"
  lxc file push --mode 0644 "$tmp/apt" "$b/etc/apt/apt.conf.d/99lxsandbox-proxy"
  lxc file push --mode 0644 "$tmp/docker" "$b/etc/systemd/system/docker.service.d/lxsandbox-proxy.conf"
  echo 'Defaults env_keep += "HTTP_PROXY HTTPS_PROXY http_proxy https_proxy NO_PROXY no_proxy"' \
    | lxc file push --mode 0440 - "$b/etc/sudoers.d/lxsandbox-proxy"
  # With only loopback, getaddrinfo(AI_ADDRCONFIG) refuses even 127.0.0.1 (apt hits this): add a
  # dummy interface. It has no routes, so it opens no way out. Waiting for the network at boot is pointless.
  printf '[Unit]\nDefaultDependencies=no\nBefore=network-pre.target sysinit.target\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/sh -c "ip link add lxs0 type dummy 2>/dev/null; ip addr replace 10.255.255.1/32 dev lxs0; ip link set lxs0 up"\n[Install]\nWantedBy=multi-user.target\n' \
    | lxc file push --mode 0644 - "$b/etc/systemd/system/lxs-dummy.service"
  lxc exec "$b" -- sh -c 'systemctl mask systemd-networkd-wait-online; systemctl daemon-reload; systemctl enable --now lxs-dummy; systemctl try-restart docker' >/dev/null 2>&1 || true
}
egress_host() { # normalize a pasted url or host to a pattern
  local h=${1#*://}; h=${h%%/*}; h=${h##*@}; echo "${h,,}"
}
egress_cmd() {
  local sub=${1:-}; shift || true
  case "$sub" in
    show) need_env "${1:?env}"; local mode; mode=$( . "$LXSANDBOX_HOME/envs/$1/env.conf"; echo "${EGRESS:-open}")
          if [ "$JSON" = 1 ]; then envs_json | jq --arg e "$1" '.[] | select(.env == $e) | {env, egress, allow}'; return; fi
          echo "env $1: egress $mode$([ "$mode" = open ] && echo " (the list below is not enforced)")"
          show "$(allow_list "$LXSANDBOX_HOME/envs/$1/egress.allow" | jq -Rnc '[inputs | {host: .}]')" "(empty allowlist)" ;;
    allow|remove)
      local e=${1:?env}; shift; need_env "$e"; local f="$LXSANDBOX_HOME/envs/$e/egress.allow" h
      [ $# -gt 0 ] || die "lxs egress $sub <env> HOST..."
      [ -f "$f" ] || egress_default > "$f"
      for h in "$@"; do h=$(egress_host "$h"); [[ $h =~ ^(\*\.)?[a-z0-9.-]+(:[0-9]+)?$|^\*$ ]] || die "bad host: $h"
        if [ "$sub" = allow ]; then
          grep -qxF "$h" "$f" && echo "already allowed: $h" || { echo "$h" >> "$f"; echo "allowed: $h"; }
        else
          grep -qxF "$h" "$f" || { echo "not in the list: $h"; continue; }
          grep -vxF "$h" "$f" > "$f.tmp"; mv "$f.tmp" "$f"; echo "removed: $h"
        fi; done ;;
    mode) local e=${1:?env} m=${2:?allowlist|open}; need_env "$e"
          [[ $m == allowlist || $m == open ]] || die "mode is allowlist or open"
          local c="$LXSANDBOX_HOME/envs/$e/env.conf"
          if grep -q '^EGRESS=' "$c"; then sed -i -E "s/^EGRESS=[a-z]*/EGRESS=$m/" "$c"; else echo "EGRESS=$m" >> "$c"; fi
          [ -f "$LXSANDBOX_HOME/envs/$e/egress.allow" ] || egress_default > "$LXSANDBOX_HOME/envs/$e/egress.allow"
          echo "env $e: egress $m for new boxes (existing boxes keep their mode)" ;;
    log) local n=40 box=""
         while [ $# -gt 0 ]; do case "$1" in -n) n=$2; shift 2;; --box) box=$2; shift 2;; *) die "lxs egress log [-n N] [--box B]";; esac; done
         show "$( { [ -f "$LXSANDBOX_HOME/egress.log" ] && cat "$LXSANDBOX_HOME/egress.log"; } | awk -v b="$box" 'b == "" || $3 == b' \
           | tail -n "$n" | jq -Rnc '[inputs | split(" ") | {time: (.[0] + " " + .[1]), box: .[2], verdict: .[3], target: .[4]}]')" "(no requests logged)" ;;
    *) die "lxs egress show|allow|remove|mode|log" ;;
  esac
}

# ---------- mcp: hooks/<HOOK> mint <box> <scope> → {"url","token"}; hooks/<HOOK> revoke <box> ----------
mcp_mint() {
  local b=$1 hook=${2%%:*} scope=${2#*:} out
  [ "$scope" = "$2" ] && scope=""
  out=$("$LXSANDBOX_HOME/hooks/$hook" mint "$b" "$scope") || die "MCP hook $hook failed to mint"
  jq -e '.url and .token' <<<"$out" >/dev/null || die "MCP hook $hook must print {\"url\":…,\"token\":…}"
  lxc config set "$b" user.lxsandbox.mcp="$hook"
  echo "$out"
}
mcp_revoke() {
  local b=$1 hook; hook=$(lxc config get "$b" user.lxsandbox.mcp 2>/dev/null || true)
  [ -n "$hook" ] && [ -x "$LXSANDBOX_HOME/hooks/$hook" ] && "$LXSANDBOX_HOME/hooks/$hook" revoke "$b" >/dev/null 2>&1
  return 0
}
mcp_reach() { # a localhost MCP url on the host stays localhost inside the box, via an LXD proxy device
  local b=$1 url=$2 port
  [[ $url =~ ^https?://(127\.0\.0\.1|localhost):([0-9]+) ]] || return 0
  port=${BASH_REMATCH[2]}
  lxc config device add "$b" mcp proxy listen=tcp:127.0.0.1:$port connect=tcp:127.0.0.1:$port bind=instance >/dev/null
}

# ---------- boxes ----------
box_new() {
  local b=${1:?box name}; shift; local e="" extra=()
  [[ $b =~ ^[a-z][a-z0-9-]*$ ]] || die "box names: start with a letter, a-z 0-9 -"
  while [ $# -gt 0 ]; do case "$1" in
    --env) e=$2; shift 2;; --repo) extra+=("$2"); shift 2;; *) die "unknown flag $1";; esac; done
  [ -n "$e" ] || die "--env required"; need_env "$e"
  local d="$LXSANDBOX_HOME/envs/$e"
  # shellcheck disable=SC1091
  . "$d/env.conf"
  lxc query "/1.0/instances/$GOLDEN/snapshots/base" >/dev/null 2>&1 || die "no golden snapshot; run: lxs image build"

  lxc copy "$GOLDEN/base" "$b" -c security.nesting=true -c security.syscalls.intercept.mknod=true \
    -c security.syscalls.intercept.setxattr=true -c limits.cpu="${CPU:-4}" -c limits.memory="${MEMORY:-8GiB}" \
    -c user.lxsandbox.env="$e"
  local mcp_url="" mcp_token="" out
  if [ -n "${MCP:-}" ]; then
    out=$(mcp_mint "$b" "$MCP"); mcp_url=$(jq -r .url <<<"$out"); mcp_token=$(jq -r .token <<<"$out")
    mcp_reach "$b" "$mcp_url"
  fi
  [ "${GITHUB:-off}" = host ] && github_devices "$b"
  [ "${EGRESS:-open}" = allowlist ] && egress_devices "$b" "$e"
  lxc start "$b"; wait_up "$b"

  # ---- agent config, built on the host and pushed in ----
  local tmp mcp_name=${MCP%%:*}; tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
  local CLONE_DIR="$tmp"
  {
    echo "# generated by lxsandbox for env $e"
    echo "export DISABLE_AUTOUPDATER=1 IS_SANDBOX=1"
    [ -n "$mcp_token" ] && echo "export MCP_TOKEN=$(q "$mcp_token")"
    grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$d/secrets.env" | sed 's/^/export /' || true
  } > "$tmp/boxenv"
  printf 'IgnoreUnknown *\n' > "$tmp/sshconfig"
  [ "${EGRESS:-open}" = allowlist ] && egress_config "$b" "$tmp"
  [ "${GITHUB:-off}" = host ] && github_config "$b" "$tmp"
  in_box "$b" 'mkdir -p ~/.ssh && chmod 700 ~/.ssh'
  lxc file push --uid 1000 --gid 1000 --mode 0600 "$tmp/sshconfig" "$b/home/agent/.ssh/config"
  jq -n --arg name "$mcp_name" --arg url "$mcp_url" --arg tok "$mcp_token" '{
      hasCompletedOnboarding: true, bypassPermissionsModeAccepted: true,
      projects: {"/work": {hasTrustDialogAccepted: true}},
      mcpServers: (if $url == "" then {} else {($name): {type: "http", url: $url, headers: {Authorization: ("Bearer " + $tok)}}} end)
    }' > "$tmp/claude.json"
  {
    echo 'approval_policy = "never"'
    echo 'sandbox_mode = "danger-full-access"'
    echo '[projects."/work"]'; echo 'trust_level = "trusted"'
    if [ -n "$mcp_url" ]; then
      echo "[mcp_servers.$mcp_name]"; echo "url = \"$mcp_url\""; echo 'bearer_token_env_var = "MCP_TOKEN"'
    fi
  } > "$tmp/codex.toml"
  lxc file push --uid 1000 --gid 1000 --mode 0600 "$tmp/boxenv" "$b/home/agent/.boxenv"
  lxc file push --uid 1000 --gid 1000 --mode 0600 "$tmp/claude.json" "$b/home/agent/.claude.json"
  in_box "$b" 'mkdir -p ~/.codex ~/.claude'
  lxc file push --uid 1000 --gid 1000 --mode 0600 "$tmp/codex.toml" "$b/home/agent/.codex/config.toml"

  # ---- repos + setup ----
  local r; for r in ${REPOS:-} "${extra[@]}"; do [ -n "$r" ] && push_repo "$b" "$(resolve_repo "$r")"; done
  # Claude trusts folders by exact path, so mark every repo as trusted too.
  in_box "$b" 'f=~/.claude.json; for d in /work/*/; do d=${d%/}; jq --arg d "$d" ".projects[\$d].hasTrustDialogAccepted = true" "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done; chmod 600 "$f"'
  if grep -qv '^#' "$d/setup.sh" 2>/dev/null; then
    lxc file push --uid 1000 --gid 1000 --mode 0700 "$d/setup.sh" "$b/home/agent/.box-setup.sh"
    in_box "$b" 'cd /work && ~/.box-setup.sh'
  fi
  echo "box $b ready (env $e). Next: lxs run $b claude \"...\""
}

boxes_json() { # boxes_json [with_sessions=1]: one lxc query, plus a tmux look into each running box
  local all; all=$(lxc list -f json | jq -c '[.[] | select(.config["user.lxsandbox.env"] != null) | {
      box: .name, state: (.status | ascii_upcase), env: .config["user.lxsandbox.env"],
      egress: (if .expanded_devices.egress then "allowlist" else "open" end),
      cpu: (.config["limits.cpu"] // ""), memory: (.config["limits.memory"] // ""),
      created: (.created_at | sub("\\..*"; "Z") | fromdate | strflocaltime("%Y-%m-%d %H:%M"))}]')
  [ "${1:-1}" = 1 ] || { echo "$all"; return; }
  jq -c '.[]' <<<"$all" | while read -r o; do
    local b s ss=""; b=$(jq -r .box <<<"$o"); s=$(jq -r .state <<<"$o")
    [ "$s" = RUNNING ] && ss=$(in_box "$b" "tmux ls -F '#S' 2>/dev/null || true" | paste -sd' ' -)
    jq -c --arg ss "$ss" '. + {sessions: ($ss | split(" ") | map(select(. != "")))}' <<<"$o"
  done | jq -sc .
}
box_ls() { show "$(boxes_json)" "no boxes (lxs new <box> --env <env>)" '{box, state, env, egress, sessions, created}'; }
box_ps() {
  show "$(in_box "${1:?box}" "tmux ls -F '#S	#{session_created}	#{session_attached}	#{pane_current_command}' 2>/dev/null || true" \
    | jq -Rnc '[inputs | split("\t") | {session: .[0], started: (.[1] | tonumber | strflocaltime("%Y-%m-%d %H:%M")),
                attached: (.[2] != "0"), running: .[3]}]')" "(no sessions)"
}
status() {
  local up=down pid; pid=$(cat "$LXSANDBOX_HOME/egress.pid" 2>/dev/null || true)
  [ -S "$EGRESS_SOCK" ] && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && up=up
  local golden=missing; lxc query "/1.0/instances/$GOLDEN/snapshots/base" >/dev/null 2>&1 && golden=ready
  if [ "$JSON" = 1 ]; then
    jq -n --arg proxy "$up" --arg golden "$golden" --argjson envs "$(envs_json)" --argjson boxes "$(boxes_json)" \
      --argjson accounts "$(accounts_json)" '{golden: $golden, egress_proxy: $proxy, accounts: $accounts, envs: $envs, boxes: $boxes}'
    return
  fi
  local h=""; [ -t 1 ] && h=1
  title() { if [ -n "$h" ]; then printf '\n\033[1;4m%s\033[0m\n' "$1"; else printf '\n%s\n' "$1"; fi; }
  printf 'golden image %s · egress proxy %s\n' "$golden" "$up"
  title Accounts; account ls
  title Envs; env_cmd ls
  title Boxes; box_ls
}

# ---------- deleting: never lose unpushed work by accident ----------
box_dirty() { # report unsaved work in /work/*; empty output = safe to delete
  in_box "$1" 'for r in /work/*/; do [ -d "$r/.git" ] || continue; cd "$r"
    d=$(git status --porcelain | wc -l); u=$(git log --branches --not --remotes --oneline | wc -l)
    [ "$d$u" = 00 ] || echo "  $(basename "$r"): $u unpushed commit(s), $d uncommitted file(s)"; done' 2>/dev/null
}
with_running() { # run "$@" with box $1 running, starting it temporarily if it was stopped
  local b=$1; shift; local was rc=0; was=$(lxc list "^$b\$" -c s -f csv)
  [ "$was" = RUNNING ] || { lxc start "$b"; wait_up "$b"; }
  "$@" || rc=$?
  [ "$was" = RUNNING ] || lxc stop "$b" --timeout 30 >/dev/null 2>&1 || lxc stop -f "$b"
  return $rc
}
box_delete() { mcp_revoke "$1"; lxc delete -f "$1"; rm -f "$LXSANDBOX_HOME/egress/$1"; }
box_rm() {
  local b=${1:?box} force=${2:-} rep
  is_box "$b" || die "$b is not a box"
  if [ "$force" != --force ]; then
    rep=$(with_running "$b" box_dirty "$b")
    [ -z "$rep" ] || { echo "box $b has unsaved work:"; echo "$rep"; die "push it, or: lxs rm $b --force"; }
  fi
  box_delete "$b"; echo "removed $b"
}
box_prune() {
  local yes=${1:-} n s found=0
  while IFS=, read -r n s <&3; do
    is_box "$n" || continue
    [ "$s" = RUNNING ] && [ "$(in_box "$n" "tmux ls 2>/dev/null | wc -l")" != 0 ] && continue
    [ -z "$(with_running "$n" box_dirty "$n")" ] || { echo "keep $n (unsaved work)"; continue; }
    found=1
    if [ "$yes" = --yes ]; then box_delete "$n"; echo "pruned $n"; else echo "would prune $n ($s)"; fi
  done 3< <(lxc list -f csv -c n,s)
  [ "$found" = 1 ] && [ "$yes" != --yes ] && echo "run: lxs prune --yes"
  return 0
}
box_start() {
  lxc config device get "${1:?box}" ssh-agent connect >/dev/null 2>&1 && ensure_agent
  lxc config device get "$1" egress connect >/dev/null 2>&1 && ensure_egress
  lxc start "$1"
}

# ---------- agent sessions ----------
agent_run() {
  local b=${1:?box} kind=${2:?claude|codex}; shift 2; local s="" cwd=/work prompt="" acc="" cmd
  while [ $# -gt 0 ]; do case "$1" in --name) s=$2; shift 2;; --cwd) cwd=$2; shift 2;; --account) acc=$2; shift 2;;
    *) prompt=$1; shift;; esac; done
  is_box "$b" || die "no box $b"
  [[ $kind == claude || $kind == codex ]] || die "agent must be claude or codex"
  acc=$(pick_account "$kind" "$acc")
  s=${s:-$kind-$(date +%H%M%S)}
  # The account is chosen per session: its credentials go into the box only now, and only that
  # session's environment points at them, so one box can run agents on different accounts.
  case "$kind" in
    claude)
      in_box "$b" 'mkdir -p ~/.lxs/claude && chmod 700 ~/.lxs ~/.lxs/claude'
      lxc file push --uid 1000 --gid 1000 --mode 0600 "$LXSANDBOX_HOME/accounts/claude/$acc.token" \
        "$b/home/agent/.lxs/claude/$acc.token"
      cmd="export CLAUDE_CODE_OAUTH_TOKEN=\$(cat ~/.lxs/claude/$acc.token); claude --dangerously-skip-permissions" ;;
    codex)
      # Codex refreshes auth.json itself, so the account dir is mounted (shared, not copied).
      lxc config device get "$b" "codex-$acc" source >/dev/null 2>&1 || lxc config device add "$b" "codex-$acc" disk \
        source="$LXSANDBOX_HOME/accounts/codex/$acc" path="/mnt/codex/$acc" shift=true >/dev/null
      in_box "$b" "h=~/.lxs/codex/$acc; mkdir -p \$h && ln -sf ~/.codex/config.toml \$h/config.toml && ln -sf /mnt/codex/$acc/auth.json \$h/auth.json"
      cmd="export CODEX_HOME=~/.lxs/codex/$acc; codex --dangerously-bypass-approvals-and-sandbox" ;;
  esac
  [ -n "$prompt" ] && cmd+=" $(q "$prompt")"
  in_box "$b" "tmux new-session -d -s $(q "$s") -x 220 -y 50 -c $(q "$cwd") $(q "bash -lc $(q "$cmd; exec bash")")"
  echo "$s"
}
pick_account() { # pick_account <claude|codex> [name] -> name, or the only one there is
  local k=$1 n=${2:-} d="$LXSANDBOX_HOME/accounts/$1" all
  if [ -n "$n" ]; then
    [[ $n =~ ^[a-z0-9-]+$ ]] && { [ -f "$d/$n.token" ] || [ -d "$d/$n" ]; } || die "no $k account $n (lxs account $k $n)"
    echo "$n"; return
  fi
  all=$(ls "$d" 2>/dev/null | sed 's/\.token$//')
  case $(grep -c . <<<"$all") in
    0) die "no $k account yet (lxs account $k <name>)" ;;
    1) echo "$all" ;;
    *) die "several $k accounts, pick one with --account: $(paste -sd' ' <<<"$all")" ;;
  esac
}
agent_send() { local b=$1 s=$2 t=$3
  in_box "$b" "tmux send-keys -t $(q "$s") -l $(q "$t") && sleep 0.3 && tmux send-keys -t $(q "$s") Enter"; }
agent_logs() { local b=$1 s=$2 n=60; [ "${3:-}" = -n ] && n=$4
  in_box "$b" "tmux capture-pane -p -t $(q "$s") -S -$n"; }

cmd=${1:-help}; shift || true
case "$cmd" in ls|env|egress|account|ps|status|st) # --json anywhere in the args
  args=(); for a in "$@"; do if [ "$a" = --json ]; then JSON=1; else args+=("$a"); fi; done
  set -- ${args[@]+"${args[@]}"} ;; esac
case "$cmd" in
  image) case "${1:-}" in build) image_build;; refresh-cli) image_refresh_cli;; *) die "lxs image build|refresh-cli";; esac ;;
  account) account "$@" ;;
  env) env_cmd "$@" ;;
  egress) egress_cmd "$@" ;;
  new) box_new "$@" ;;
  ls) box_ls ;;
  status|st) status ;;
  rm) box_rm "$@" ;;
  prune) box_prune "$@" ;;
  stop) lxc stop "${1:?box}" ;;
  start) box_start "$@" ;;
  shell) lxc exec "${1:?box}" -- sudo -iu agent ;;
  snap) lxc snapshot "${1:?box}" ${2:+"$2"} ;;
  run) agent_run "$@" ;;
  ps) box_ps "$@" ;;
  send) agent_send "${1:?box}" "${2:?session}" "${3:?text}" ;;
  logs) agent_logs "$@" ;;
  attach) lxc exec "${1:?box}" -t -- sudo -iu agent tmux attach -t "${2:?session}" ;;
  kill) in_box "${1:?box}" "tmux kill-session -t $(q "${2:?session}")" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
